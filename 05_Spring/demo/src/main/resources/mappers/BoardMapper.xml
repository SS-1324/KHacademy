<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    namespace : 해당 XML파일을 어떤 Mapper 인터페이스와 연결할지를 정해주는 속성.
-->
<mapper namespace="com.kh.demo.board.mapper.BoardMapper">
    <!--
        <sql id=".."> : 여러 <select> 태그에서 공통으로 쓰는 sql 조각을
        한곳에 정의해두고 <include refid="..."로 재사용 가능.
    -->
    <sql id="searchWhere">
        <!--
            <where> : 내부의 <if>들 중 하나라도 참이면 자동으로 WHERE키워드를 붙여주고,
            맨 앞에 남는 불필요한 AND/OR은 자동으로 제거해준다
        -->
        <where>
            <if test="category != null and category != '' and category != '전체'">
                AND b.category = #{category}
            </if>

            <if test="keyword != null and keyword != ''">
                <choose>
                    <when test="searchType == 'title'">
                        AND b.title LIKE CONCAT('%', #{keyword}, '%')
                    </when>
                    <when test="searchType == 'content'">
                        AND b.content LIKE CONCAT('%', #{keyword}, '%')
                    </when>
                    <when test="searchType == 'writer'">
                        AND m.nickname LIKE CONCAT('%', #{keyword}, '%')
                    </when>
                    <otherwise>
                        AND (b.title LIKE CONCAT('%', #{keyword}, '%')
                            OR b.content LIKE CONCAT('%', #{keyword}, '%'))
                    </otherwise>
                </choose>
            </if>
        </where>
    </sql>

    <!--
    useGeneratedKeys="true" : DB가 자동으로 생성해주는 키를 mybatis로 가져올 수 있게 허용
    keyProperty="boardId" : DB에서 자동으로 생성된 PK값을 파라미터의 어떤 변수에 넣을 것인가
    -->
    <insert id="insertBoard" parameterType="BoardDto" useGeneratedKeys="true" keyProperty="boardId">
        INSERT INTO board (member_id, category, title, content, count)
        VALUES (#{memberId}, #{category}, #{title}, #{content}, 0)
    </insert>
    <!--
       <foreach> 태그로 여러건의 이미지를 insert문 한번으로 저장(batch insert)
       -> 건별로 insert를 N번실행하면 네트워크를 DB까지 N번 왕복한다.
    -->
    <insert id="insertBoardImages" parameterType="list">
        INSERT INTO board_image (board_id, original_name, save_name, image_path, image_order)
        VALUES
        <foreach collection="images" item="img" separator=",">
            (#{img.boardId},#{img.originalName},#{img.saveName},#{img.imagePath},#{img.imageOrder})
        </foreach>
    </insert>

    <select id="selectBoardList" parameterType="BoardSearchCondition" resultType="BoardDto">
        SELECT b.board_id, b.member_id, b.category, b.title, b.count, b.create_at, b.update_at,
                DATE_FORMAT(b.create_at, '%Y-%M-%d %H:%i') AS create_at_str,
                m.nickname AS writer_nickname
        FROM board b
        LEFT JOIN member m ON b.member_id = m.member_id
        <include refid="searchWhere" />
        ORDER BY b.board_id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="selectBoardListCount" parameterType="BoardSearchCondition" resultType="int">
        SELECT COUNT(*)
        FROM board b
        LEFT JOIN member m ON b.member_id = m.member_id
        <include refid="searchWhere" />
    </select>
</mapper>